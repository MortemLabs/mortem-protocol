# Dependencies and generated build output are recreated in the image.
node_modules
**/node_modules
.next
**/.next
dist
**/dist
coverage
**/coverage

# Keep credentials and local configuration out of the image context.
.env
.env.*
!.env.example
!**/.env.example

# VCS, editor, and local-only files.
.git
.gitignore
.DS_Store
.idea
.vscode
*.log
README.md
brand.md
early-access-video-script.md
