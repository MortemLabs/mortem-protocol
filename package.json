{
  "name": "mortem-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Production-grade observability and debugging platform for TypeScript AI agents running on Solana.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build --filter=!@mortemlabs/anchor-worker",
    "clean": "turbo run clean --filter=!@mortemlabs/anchor-worker",
    "dev": "turbo run dev --filter=!@mortemlabs/anchor-worker",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test --filter=!@mortemlabs/anchor-worker",
    "typecheck": "turbo run typecheck --filter=!@mortemlabs/anchor-worker"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@solana/web3.js": "^1.95.8",
    "@types/node": "^22.15.2",
    "tsx": "^4.19.4",
    "turbo": "2.5.0",
    "typescript": "5.4.5"
  }
}
