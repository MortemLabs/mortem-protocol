# Mortem workspace environment template. Copy only the variables needed by the app you run into a
# local .env file or deployment secret store; never commit real secrets.

# Database
DATABASE_URL=postgresql://mortem:mortem@localhost:5432/mortem

# Upstash Redis REST API. REDIS_* are accepted aliases used by the apps.
REDIS_URL=https://example-upstash.upstash.io
REDIS_TOKEN=
UPSTASH_REDIS_REST_URL=https://example-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=

# Helius / Solana devnet
HELIUS_API_KEY=
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=
HELIUS_WEBHOOK_SECRET=
MORTEM_PROGRAM_ID=
NEXT_PUBLIC_MORTEM_PROGRAM_ID=
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
MINIMUM_PDA_LAMPORTS=5000000

# LLM analysis
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:72b
ANALYSIS_WORKER_AUTOSTART=true

# SDK payload encryption. Generate with: openssl rand -base64 32
MORTEM_MASTER_KEY=

# Ingest service
INGEST_HOST=0.0.0.0
PORT=4001
INGEST_MAX_BODY_BYTES=10485760
INGEST_RATELIMIT_PER_MIN=10000
NEXT_PUBLIC_MORTEM_INGEST_URL=http://localhost:4001

# API server
NEXT_PUBLIC_MORTEM_SERVER_URL=http://localhost:3001/api/trpc

# Anchor worker
ANCHOR_WALLET_SECRET_KEY=
ANCHOR_WORKER_INTERVAL_MS=60000
ANCHOR_WORKER_MAX_BATCH_SIZE=100

# Enrichment worker
ENRICHMENT_HOST=0.0.0.0
ENRICHMENT_PORT=4002
