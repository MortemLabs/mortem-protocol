{
  "name": "@mortemlabs/sdk",
  "version": "0.0.3",
  "description": "Mortem TypeScript SDK for AI agent observability.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mortemlabs/shared": "workspace:*",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "vitest": "^1.6.1"
  }
}
