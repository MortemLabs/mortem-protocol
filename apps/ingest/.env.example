# Ingest service environment template. The service validates SDK batches, verifies live-mode Privy
# JWTs, writes traces through Prisma, and queues analysis and anchor work through Redis.

DATABASE_URL=postgresql://mortem:mortem@localhost:5432/mortem

# Upstash Redis REST API. REDIS_* are accepted aliases used by the service.
REDIS_URL=https://example-upstash.upstash.io
REDIS_TOKEN=
UPSTASH_REDIS_REST_URL=https://example-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=

PRIVY_APP_ID=
PRIVY_APP_SECRET=

INGEST_HOST=0.0.0.0
PORT=4001
INGEST_MAX_BODY_BYTES=10485760
INGEST_RATELIMIT_PER_MIN=10000
