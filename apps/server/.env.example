# Server environment template. This Next.js app hosts tRPC, Privy JWT verification, public trace
# verification, memo-anchor inspection, and the analysis worker.

DATABASE_URL=postgresql://mortem:mortem@localhost:5432/mortem

# Upstash Redis REST API. REDIS_* are accepted aliases used by the server.
REDIS_URL=https://example-upstash.upstash.io
REDIS_TOKEN=
UPSTASH_REDIS_REST_URL=https://example-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=

PRIVY_APP_ID=
PRIVY_APP_SECRET=

LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANALYSIS_WORKER_AUTOSTART=true

# ── Ollama configuration ────────────────────────────────
# Uses Ollama's hosted cloud API — no local installation needed.
# Get your API key: https://ollama.com/settings/keys
# View usage + billing: https://ollama.com/settings/usage
#
# LLM_PROVIDER=ollama
# OLLAMA_API_KEY=your_key_here
# OLLAMA_MODEL=kimi-k2.5:cloud
# ────────────────────────────────────────────────────────

HELIUS_API_KEY=
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=
HELIUS_WEBHOOK_ID=
