{
  "name": "@mortemlabs/anchor-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Worker that commits Mortem trace Merkle batches to Solana devnet.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mortemlabs/db": "workspace:*",
    "@mortemlabs/shared": "workspace:*",
    "@solana/web3.js": "^1.95.8",
    "@upstash/redis": "^1.35.5",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "vitest": "^1.6.1"
  }
}
