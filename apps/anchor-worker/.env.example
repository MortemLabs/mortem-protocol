# Anchor worker environment template. It commits completed trace batches with Solana memo
# transactions and therefore needs database, Redis, RPC, and backend signer configuration.

DATABASE_URL=postgresql://mortem:mortem@localhost:5432/mortem

# Upstash Redis REST API. REDIS_* are accepted aliases used by the worker.
REDIS_URL=https://example-upstash.upstash.io
REDIS_TOKEN=
UPSTASH_REDIS_REST_URL=https://example-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=

HELIUS_API_KEY=
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=

# Base58-encoded Solana keypair secret for the backend memo signer wallet.
MORTEM_SIGNER_SECRET_KEY=
ANCHOR_WORKER_INTERVAL_MS=60000
ANCHOR_WORKER_MAX_BATCH_SIZE=100
