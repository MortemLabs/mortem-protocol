# Enrichment worker environment template. It receives Helius webhooks, verifies HMAC signatures,
# enriches matching Solana transaction events, and publishes readiness signals.

DATABASE_URL=postgresql://mortem:mortem@localhost:5432/mortem

# Upstash Redis REST API. REDIS_* are accepted aliases used by the worker.
REDIS_URL=https://example-upstash.upstash.io
REDIS_TOKEN=
UPSTASH_REDIS_REST_URL=https://example-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=

HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=

ENRICHMENT_HOST=0.0.0.0
ENRICHMENT_PORT=4002
INGEST_MAX_BODY_BYTES=10485760
